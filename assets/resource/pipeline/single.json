{
  "ui_simplified_entry": {
    "next": ["SingleFreeBand"],
    "timeout": 5000,
    "on_error": ["stop"]
  },
  "SingleFreeBand": {
    "recognition": "And",
    "all_of": [
      "SoloFreeReady",
      "PlayBandDifficulty",
      "PlayAutoOff"
    ],
    "next": ["SingleReadSong"],
    "timeout": 5000,
    "on_error": ["stop"]
  },
  "SingleReadSong": {
    "recognition": "Custom",
    "custom_recognition": "SongRecognition",
    "custom_recognition_param": {"ocr_node": "PlayBandSongTitle"},
    "action": "Custom",
    "custom_action": "SaveSong",
    "custom_action_param": {"touch_backend": "legacy"},
    "next": ["startlivesingle"],
    "timeout": 5000,
    "on_error": ["stop"]
  },
  "startlivesingle": {
    "recognition": "And",
    "all_of": [
      "SingleFreeBand",
      "PlayStartButton",
      "PlayPresentationOff"
    ],
    "box_index": 1,
    "action": "Click",
    "next": ["playsongsingle"],
    "timeout": 5000,
    "on_error": ["stop"]
  },
  "playsongsingle": {
    "action": "Custom",
    "custom_action": "Play",
    "post_delay": 0
  }
}
