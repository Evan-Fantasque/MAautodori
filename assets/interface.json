{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MAautodori",
    "description": "这是使用 MaaFramework 创建的 MAautodori 项目。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAautodori!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/Evan-Fantasque/MAautodori",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "ADB",
            "label": "模拟器",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "简中服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "agent": {
        "child_exec": "../.venv/Scripts/python.exe",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "启动游戏到主菜单",
            "entry": "start_app"
        },
        {
            "name": "单人演出准备（停在开打前）",
            "entry": "SoloPrepare",
            "option": ["单人模式"]
        },
        {
            "name": "自由演出（单曲）",
            "entry": "ui_simplified_entry"
        },
        {
            "name": "每日清火＋免费三抽",
            "entry": "DailyClear",
            "option": ["清火设置"]
        },
        {
            "name": "自由演出（挖矿）",
            "entry": "select_song",
            "option": ["检查火焰"]
        },
        {
            "name": "巡回演出",
            "entry": "MedleyEntry",
            "option": [],
            "pipeline_override": {}
        },
        {
            "name": "测试任务",
            "entry": "TestEntry"
        },
        {
            "name": "测试任务1",
            "entry": "TestEntry1"
        }
        //{
        //    "name": "活动任务自动打歌",
        //    "entry": "MissionEntry"
        //}
    ],
    "option": {
        "清火设置": {
            "type": "input",
            "inputs": [
                {"name": "song", "label": "完整曲名", "default": "SAVIOR OF SONG", "verify": "^.*\\S.*$"},
                {"name": "difficulty", "label": "难度", "default": "EXPERT", "verify": "^(EASY|NORMAL|HARD|EXPERT|SPECIAL)$"},
                {"name": "regular", "label": "常规用火", "default": "3", "pipeline_type": "int", "verify": "^[123]$"},
                {"name": "max", "label": "优先10火", "default": "开", "verify": "^(开|关)$"}
            ],
            "pipeline_override": {
                "DailyClear": {"custom_action_param": {"title": "{song}", "difficulty": "{difficulty}", "regular": "{regular}", "max": "{max}"}}
            }
        },
        "检查火焰": {
            "type": "switch",
            "description": "演出开始前检查火焰。为零时关闭游戏，无法读出时停止任务。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "disable_liveplay": {"next": ["PlayCheckBoost"]}
                    }
                },
                {"name": "No"}
            ]
        },
        "单人模式": {
            "type": "select",
            "cases": [
                {
                    "name": "自由演出",
                    "pipeline_override": {"SoloModeMenu": {"next": ["SoloEnterFree"]}}
                },
                {
                    "name": "挑战演出",
                    "pipeline_override": {"SoloModeMenu": {"next": ["SoloEnterChallenge"]}}
                },
                {
                    "name": "舞台挑战（主舞台）",
                    "pipeline_override": {"SoloModeMenu": {"next": ["SoloEnterStage"]}}
                },
                {
                    "name": "舞台挑战（特别舞台）",
                    "pipeline_override": {
                        "SoloModeMenu": {"next": ["SoloEnterStage"]},
                        "SoloEnterStage": {"next": ["SoloSpecialStageCatalog", "[JumpBack]SoloSwitchSpecialStage"]}
                    }
                }
            ]
        },
        "任务选项1": {
            "type": "select",
            "cases": [
                {
                    "name": "文本1",
                    "pipeline_override": {
                        "OcrTask": {
                            "text": "文本1"
                        }
                    }
                },
                {
                    "name": "文本2",
                    "pipeline_override": {
                        "OcrTask": {
                            "text": "文本2"
                        }
                    }
                }
            ]
        }
    }
}
