{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MAautodori",
    "description": "这是使用 MaaFramework 创建的 MAautodori 项目。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAautodori!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/Evan-Fantasque/MAautodori",
    "version": "v1.4.1",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "ADB",
            "label": "模拟器",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "简中服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "agent": {
        "child_exec": "../.venv/Scripts/python.exe",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "preset": [
        {
            "name": "启动模拟器到一键每日",
            "description": "依次进入游戏主菜单并执行一键每日。首次请配置 MuMu 前置程序，并保存要连接的模拟器设备。",
            "controller": ["ADB"],
            "task": [
                {"name": "启动游戏到主菜单", "enabled": true},
                {"name": "每日清火＋免费三抽", "enabled": true}
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏到主菜单",
            "entry": "start_app"
        },
        {
            "name": "单人演出准备（停在开打前）",
            "entry": "SoloPrepare",
            "option": ["单人模式"]
        },
        {
            "name": "自由演出（单曲）",
            "entry": "ui_simplified_entry"
        },
        {
            "name": "挑战演出",
            "entry": "ChallengeLive",
            "description": "循环进行活动单人挑战演出。每场结算后重新读取所持挑战点数。",
            "option": ["挑战曲目", "难度", "挑战点数档", "点数不足时"]
        },
        {
            "name": "舞台挑战（单场）",
            "entry": "StageChallenge",
            "description": "从主菜单进入舞台挑战，也可接续已选关或已编队的页面。按当前关卡、难度和用火设置打一场。",
            "option": ["舞台类型", "舞台推荐编组", "舞台区域道具"]
        },
        {
            "name": "每日清火＋免费三抽",
            "entry": "DailyClear",
            "description": "一键清火并领完每日免费演出招募。0 火且尚未满足演出条件时，补打一场 0 火自由演出。",
            "option": ["清火设置", "难度", "常规用火", "优先10火"]
        },
        {
            "name": "每日清火",
            "entry": "DailyBurnBoost",
            "description": "循环进行普通单人自由演出，读到 0 火后结束。",
            "option": ["清火设置", "难度", "常规用火", "优先10火"]
        },
        {
            "name": "每日免费招募",
            "entry": "DailyFreeRecruit",
            "description": "领完当天剩余的免费演出招募次数。需要先完成演出时停止。"
        },
        {
            "name": "自由演出（挖矿）",
            "entry": "select_song",
            "option": ["检查火焰"]
        },
        {
            "name": "巡回演出",
            "label": "巡回演出（可靠性未验证）",
            "entry": "MedleyEntry",
            "option": [],
            "pipeline_override": {}
        }
        //{
        //    "name": "活动任务自动打歌",
        //    "entry": "MissionEntry"
        //}
    ],
    "global_option": ["打歌触控链路"],
    "setting": [
        {"name": "rhythm", "label": "打歌", "option": ["打歌触控链路"]}
    ],
    "option": {
        "打歌触控链路": {
            "type": "select",
            "description": "用于自由演出、挑战演出、舞台挑战及每日清火的打歌环节。EvATive7 使用设备执行反馈补偿延迟。",
            "default_case": "EvATive7",
            "cases": [
                {"name": "EvATive7", "label": "EvATive7 Minitouch（默认，延迟补偿）", "pipeline_override": {
                    "SingleReadSong": {"custom_action_param": {"touch_backend": "legacy"}},
                    "MiningReadSong": {"custom_action_param": {"touch_backend": "legacy"}}
                }},
                {"name": "MaaFramework", "label": "MaaFramework", "pipeline_override": {
                    "SingleReadSong": {"custom_action_param": {"touch_backend": "maafw"}},
                    "MiningReadSong": {"custom_action_param": {"touch_backend": "maafw"}}
                }}
            ]
        },
        "挑战曲目": {
            "type": "input",
            "inputs": [{"name": "song", "label": "完整曲名（留空沿用当前曲目）", "default": ""}],
            "pipeline_override": {"ChallengeLive": {"custom_action_param": {"title": "{song}"}}}
        },
        "舞台类型": {
            "type": "select",
            "description": "从主菜单进入时选择目录。已在舞台选关或编队页时沿用当前关卡。",
            "default_case": "主舞台",
            "cases": [
                {"name": "主舞台", "pipeline_override": {"StageChallenge": {"attach": {"special": false}}}},
                {"name": "特别舞台", "pipeline_override": {"StageChallenge": {"attach": {"special": true}}}}
            ]
        },
        "舞台推荐编组": {
            "type": "switch",
            "description": "开演前使用游戏的舞台推荐编组。关闭时沿用当前乐队。",
            "default_case": "No",
            "cases": [
                {"name": "Yes", "pipeline_override": {"StageChallenge": {"attach": {"recommend": true}}}},
                {"name": "No"}
            ]
        },
        "舞台区域道具": {
            "type": "switch",
            "description": "游戏提示时确认更换为推荐区域道具，会改变当前道具摆放。关闭时停在确认窗口。",
            "default_case": "No",
            "cases": [
                {"name": "Yes", "pipeline_override": {"StageChallenge": {"attach": {"change_area_items": true}}}},
                {"name": "No"}
            ]
        },
        "清火设置": {
            "type": "input",
            "inputs": [
                {"name": "song", "label": "完整曲名", "default": "SAVIOR OF SONG", "verify": "^.*\\S.*$"}
            ],
            "pipeline_override": {
                "DailyClear": {"custom_action_param": {"title": "{song}", "recruit_after": true}},
                "DailyBurnBoost": {"custom_action_param": {"title": "{song}", "recruit_after": false}}
            }
        },
        "难度": {
            "type": "select",
            "default_case": "EXPERT",
            "cases": [
                {
                    "name": "EASY",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"difficulty": "EASY"}},
                        "DailyBurnBoost": {"attach": {"difficulty": "EASY"}},
                        "ChallengeLive": {"attach": {"difficulty": "EASY"}}
                    }
                },
                {
                    "name": "NORMAL",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"difficulty": "NORMAL"}},
                        "DailyBurnBoost": {"attach": {"difficulty": "NORMAL"}},
                        "ChallengeLive": {"attach": {"difficulty": "NORMAL"}}
                    }
                },
                {
                    "name": "HARD",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"difficulty": "HARD"}},
                        "DailyBurnBoost": {"attach": {"difficulty": "HARD"}},
                        "ChallengeLive": {"attach": {"difficulty": "HARD"}}
                    }
                },
                {
                    "name": "EXPERT",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"difficulty": "EXPERT"}},
                        "DailyBurnBoost": {"attach": {"difficulty": "EXPERT"}},
                        "ChallengeLive": {"attach": {"difficulty": "EXPERT"}}
                    }
                },
                {
                    "name": "SPECIAL",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"difficulty": "SPECIAL"}},
                        "DailyBurnBoost": {"attach": {"difficulty": "SPECIAL"}},
                        "ChallengeLive": {"attach": {"difficulty": "SPECIAL"}}
                    }
                }
            ]
        },
        "挑战点数档": {
            "type": "select",
            "default_case": "200",
            "cases": [
                {"name": "200", "label": "200 点（1 倍）", "pipeline_override": {"ChallengeLive": {"attach": {"cp_tier": 200}}}},
                {"name": "400", "label": "400 点（2 倍）", "pipeline_override": {"ChallengeLive": {"attach": {"cp_tier": 400}}}},
                {"name": "800", "label": "800 点（4 倍）", "pipeline_override": {"ChallengeLive": {"attach": {"cp_tier": 800}}}},
                {"name": "1600", "label": "1600 点（8 倍）", "pipeline_override": {"ChallengeLive": {"attach": {"cp_tier": 1600}}}}
            ]
        },
        "点数不足时": {
            "type": "select",
            "description": "可以直接停止，也可以改用还付得起的最高档。降档下限不能高于首选档。",
            "default_case": "停止",
            "cases": [
                {"name": "停止", "pipeline_override": {"ChallengeLive": {"attach": {"cp_floor": 0}}}},
                {"name": "降档至最低 200 点", "pipeline_override": {"ChallengeLive": {"attach": {"cp_floor": 200}}}},
                {"name": "降档至最低 400 点", "pipeline_override": {"ChallengeLive": {"attach": {"cp_floor": 400}}}},
                {"name": "降档至最低 800 点", "pipeline_override": {"ChallengeLive": {"attach": {"cp_floor": 800}}}}
            ]
        },
        "常规用火": {
            "type": "select",
            "default_case": "3",
            "cases": [
                {
                    "name": "1",
                    "label": "1 火",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"regular": 1}},
                        "DailyBurnBoost": {"attach": {"regular": 1}}
                    }
                },
                {
                    "name": "2",
                    "label": "2 火",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"regular": 2}},
                        "DailyBurnBoost": {"attach": {"regular": 2}}
                    }
                },
                {
                    "name": "3",
                    "label": "3 火",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"regular": 3}},
                        "DailyBurnBoost": {"attach": {"regular": 3}}
                    }
                }
            ]
        },
        "优先10火": {
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"prioritize_max": true}},
                        "DailyBurnBoost": {"attach": {"prioritize_max": true}}
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyClear": {"attach": {"prioritize_max": false}},
                        "DailyBurnBoost": {"attach": {"prioritize_max": false}}
                    }
                }
            ]
        },
        "检查火焰": {
            "type": "switch",
            "description": "演出开始前检查火焰。为零时关闭游戏，无法读出时停止任务。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "disable_liveplay": {"next": ["PlayCheckBoost"]}
                    }
                },
                {"name": "No"}
            ]
        },
        "单人模式": {
            "type": "select",
            "cases": [
                {
                    "name": "自由演出",
                    "pipeline_override": {"SoloModeMenu": {"next": ["GameErrorDialog", "SoloEnterFree"]}}
                },
                {
                    "name": "挑战演出",
                    "pipeline_override": {"SoloModeMenu": {"next": ["GameErrorDialog", "SoloEnterChallenge"]}}
                },
                {
                    "name": "舞台挑战（主舞台）",
                    "pipeline_override": {"SoloModeMenu": {"next": ["GameErrorDialog", "SoloEnterStage"]}}
                },
                {
                    "name": "舞台挑战（特别舞台）",
                    "pipeline_override": {
                        "SoloModeMenu": {"next": ["GameErrorDialog", "SoloEnterStage"]},
                        "SoloEnterStage": {"next": ["GameErrorDialog", "SoloSpecialStageCatalog", "[JumpBack]SoloSwitchSpecialStage"]}
                    }
                }
            ]
        }
    }
}
