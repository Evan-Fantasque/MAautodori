diff --git a/src/components/settings/GithubPortableUpdate.tsx b/src/components/settings/GithubPortableUpdate.tsx
new file mode 100644
index 0000000..76ae818
--- /dev/null
+++ b/src/components/settings/GithubPortableUpdate.tsx
@@ -0,0 +1,184 @@
+import { useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Download } from 'lucide-react';
+import { invoke } from '@tauri-apps/api/core';
+import { useAppStore } from '@/stores/appStore';
+import type { DownloadProgress } from '@/stores/types';
+import { checkPortableUpdate, type PortableUpdate } from '@/services/githubPortableUpdate';
+import {
+  downloadUpdate,
+  getUpdateSavePath,
+  isDebugVersion,
+  restartApp,
+} from '@/services/updateService';
+import { DownloadProgressBar, ReleaseNotes, VersionInfo } from '../UpdateInfoCard';
+import { loggers } from '@/utils/logger';
+
+type Phase = 'checking' | 'downloading' | 'installing' | 'done';
+
+export function GithubPortableUpdate({ version }: { version: string }) {
+  const { t } = useTranslation();
+  const channel = useAppStore((state) => state.mirrorChyanSettings.channel);
+  const setChannel = useAppStore((state) => state.setMirrorChyanChannel);
+  const proxy = useAppStore((state) => state.proxySettings);
+  const [update, setUpdate] = useState<PortableUpdate | null>();
+  const [phase, setPhase] = useState<Phase>();
+  const [progress, setProgress] = useState<DownloadProgress | null>(null);
+  const [detail, setDetail] = useState<string>();
+  const [error, setError] = useState<string>();
+  const active = useRef(false);
+  const busy = phase !== undefined && phase !== 'done';
+
+  async function check() {
+    if (active.current) return;
+    active.current = true;
+    setPhase('checking');
+    setError(undefined);
+    setDetail(undefined);
+    setUpdate(undefined);
+    try {
+      setUpdate(await checkPortableUpdate(version, channel !== 'stable', proxy?.url));
+    } catch (err) {
+      setError(`${t('mirrorChyan.checkFailed')} (${String(err)})`);
+    } finally {
+      active.current = false;
+      setPhase(undefined);
+    }
+  }
+
+  async function install() {
+    if (!update || active.current) return;
+    active.current = true;
+    setError(undefined);
+    try {
+      for (const asset of update.delta ? [update.delta, update.full] : [update.full]) {
+        const incremental = asset === update.delta;
+        setDetail(incremental ? 'incremental' : 'full');
+        setProgress(null);
+        setPhase('downloading');
+        try {
+          const downloaded = await downloadUpdate({
+            url: asset.browser_download_url,
+            savePath: await getUpdateSavePath(asset.name),
+            totalSize: asset.size,
+            proxySettings: proxy,
+            onProgress: setProgress,
+          });
+          if (!downloaded.success || !downloaded.actualSavePath) {
+            throw new Error(t('mirrorChyan.downloadFailed'));
+          }
+          setPhase('installing');
+          await invoke('maautodori_apply_update', {
+            zipPath: downloaded.actualSavePath,
+            digest: asset.digest,
+            from: version,
+            to: update.version,
+            incremental,
+          });
+          setPhase('done');
+          return;
+        } catch (err) {
+          const reason = String(err);
+          if (!incremental || reason.includes('UPDATE_BUSY') || reason.includes('ROLLBACK_FAILED'))
+            throw err;
+          loggers.ui.warn('Incremental update failed; downloading the full package', err);
+        }
+      }
+    } catch (err) {
+      const reason = String(err);
+      setError(
+        reason.includes('UPDATE_BUSY')
+          ? t('maautodoriUpdate.busy')
+          : `${t('mirrorChyan.installFailed')} (${reason})`,
+      );
+      setPhase(undefined);
+    } finally {
+      active.current = false;
+    }
+  }
+
+  const button = 'px-4 py-2 rounded-lg bg-accent text-white disabled:opacity-50';
+  return (
+    <section id="section-update" className="space-y-4 scroll-mt-4">
+      <h2 className="text-sm font-semibold text-text-primary uppercase tracking-wider flex items-center gap-2">
+        <Download className="w-4 h-4" />
+        {t('mirrorChyan.title')}
+      </h2>
+      <div className="bg-bg-secondary rounded-xl p-4 border border-border space-y-4">
+        {isDebugVersion(version) ? (
+          <p>{t('mirrorChyan.debugModeNotice')}</p>
+        ) : (
+          <>
+            <label className="flex items-center gap-3">
+              {t('mirrorChyan.channel')}
+              <select
+                value={channel}
+                disabled={busy || phase === 'done'}
+                onChange={(event) => {
+                  setChannel(event.target.value === 'stable' ? 'stable' : 'beta');
+                  setUpdate(undefined);
+                  setError(undefined);
+                }}
+                className="rounded-lg bg-bg-tertiary px-3 py-2"
+              >
+                <option value="stable">{t('mirrorChyan.channelStable')}</option>
+                <option value="beta">{t('mirrorChyan.channelBeta')}</option>
+              </select>
+            </label>
+            {update && (
+              <>
+                <VersionInfo
+                  currentVersion={version}
+                  latestVersion={update.version}
+                  channel={channel}
+                />
+                <ReleaseNotes releaseNote={update.notes} />
+              </>
+            )}
+            {phase === 'downloading' && (
+              <DownloadProgressBar
+                downloadStatus="downloading"
+                downloadProgress={progress}
+                showActions={false}
+              />
+            )}
+            {detail && (
+              <p role="status">
+                {t(`mirrorChyan.installStages.${detail}`)}
+                {phase === 'installing' ? ` · ${t('mirrorChyan.installing')}` : ''}
+              </p>
+            )}
+            {phase === 'done' && <p role="status">{t('mirrorChyan.restartRequired')}</p>}
+            {update === null && <p role="status">{t('mirrorChyan.upToDate', { version })}</p>}
+            {error && (
+              <p role="alert" className="text-error text-sm">
+                {error}
+              </p>
+            )}
+            {phase === 'done' ? (
+              <button
+                className={button}
+                onClick={() => {
+                  void restartApp().catch((err) => setError(String(err)));
+                }}
+              >
+                {t('mirrorChyan.restartNow')}
+              </button>
+            ) : (
+              <div className="flex flex-wrap gap-2">
+                <button className={button} disabled={busy} onClick={() => void check()}>
+                  {t(phase === 'checking' ? 'mirrorChyan.checking' : 'mirrorChyan.checkUpdate')}
+                </button>
+                {update && (
+                  <button className={button} disabled={busy} onClick={() => void install()}>
+                    {t('maautodoriUpdate.downloadInstall')}
+                  </button>
+                )}
+              </div>
+            )}
+          </>
+        )}
+      </div>
+    </section>
+  );
+}
