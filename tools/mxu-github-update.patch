+//! Update managed files using an authenticated index of the portable ZIP.
+
+use super::{
+    apply_files, check_interface, file_hash, local_path, managed, result, update_target, when_idle,
+    PREFIX, PROJECT, ROOT_FILES,
+};
+use flate2::read::{DeflateDecoder, GzDecoder};
+use reqwest::{blocking::Client, header, redirect, StatusCode};
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::{self, File},
+    io::{self, Read},
+    path::Path,
+    time::Duration,
+};
+
+const MANIFEST: &str = "share/MAautodori-update-files.json";
+const MAX_INDEX: u64 = 2 * 1024 * 1024;
+const MAX_JSON: u64 = 16 * 1024 * 1024;
+
+#[derive(Deserialize)]
+struct Entry {
+    offset: u64,
+    packed: u64,
+    size: u64,
+    compression: u16,
+    sha256: String,
+}
+
+#[derive(Deserialize)]
+struct Index {
+    format: u32,
+    version: String,
+    archive_size: u64,
+    archive_sha256: String,
+    files: BTreeMap<String, Entry>,
+}
+
+#[derive(Deserialize)]
+struct Manifest {
+    version: String,
+    files: BTreeMap<String, String>,
+}
+
+#[derive(PartialEq, Eq)]
+struct Plan {
+    replace: BTreeMap<String, String>,
+    remove: Vec<String>,
+}
+
+fn hex_digest(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+
+fn read_index(
+    bytes: &[u8],
+    index_digest: &str,
+    archive_digest: &str,
+    archive_size: u64,
+    version: &str,
+) -> Result<Index, String> {
+    if bytes.len() as u64 > MAX_INDEX
+        || index_digest.strip_prefix("sha256:")
+            != Some(format!("{:x}", Sha256::digest(bytes)).as_str())
+    {
+        return Err("The update index failed SHA-256 verification".into());
+    }
+    let index: Index = result(serde_json::from_reader(
+        GzDecoder::new(bytes).take(MAX_JSON),
+    ))?;
+    let mut windows_names = BTreeSet::new();
+    if index.format != 1
+        || index.version != version
+        || index.archive_size != archive_size
+        || archive_digest.strip_prefix("sha256:") != Some(index.archive_sha256.as_str())
+        || !hex_digest(&index.archive_sha256)
+        || !ROOT_FILES
+            .iter()
+            .chain(&[
+                MANIFEST,
+                "agent/main.py",
+                "python/python.exe",
+                "maafw/MaaFramework.dll",
+            ])
+            .all(|name| index.files.contains_key(*name))
+        || index.files.iter().any(|(name, entry)| {
+            !managed(name)
+                || !windows_names.insert(name.to_lowercase())
+                || !hex_digest(&entry.sha256)
+                || entry.packed == 0
+                || entry.size > u32::MAX as u64
+                || !(entry.compression == 8
+                    || (entry.compression == 0 && entry.size == entry.packed))
+                || entry
+                    .offset
+                    .checked_add(entry.packed)
+                    .is_none_or(|end| end > archive_size)
+        })
+    {
+        return Err("The update index does not match this portable ZIP".into());
+    }
+    Ok(index)
+}
+
+fn read_manifest(root: &Path, version: &str) -> Result<Manifest, String> {
+    let path = local_path(root, MANIFEST)?;
+    let file = result(File::open(path))?;
+    if result(file.metadata())?.len() > MAX_JSON {
+        return Err("The installed file inventory is too large".into());
+    }
+    let manifest: Manifest = result(serde_json::from_reader(file))?;
+    let mut windows_names = BTreeSet::new();
+    if manifest.version != version
+        || manifest.files.iter().any(|(name, digest)| {
+            name == MANIFEST
+                || !managed(name)
+                || !hex_digest(digest)
+                || !windows_names.insert(name.to_lowercase())
+        })
+    {
+        return Err("The installed file inventory does not match this version".into());
+    }
+    Ok(manifest)
+}
+
+fn plan_update(target: &Path, index: &Index, installed: &Manifest) -> Result<Plan, String> {
+    let mut plan = Plan {
+        replace: BTreeMap::new(),
+        remove: Vec::new(),
+    };
+    for (name, entry) in &index.files {
+        let path = local_path(target, name)?;
+        match fs::metadata(&path) {
+            Ok(metadata) if metadata.is_file() => {
+                if metadata.len() == entry.size && file_hash(&path)? == entry.sha256 {
+                    continue;
+                }
+                if name != MANIFEST && !installed.files.contains_key(name) {
+                    return Err(format!(
+                        "A new program file would replace a local file: {name}"
+                    ));
+                }
+            }
+            Ok(_) => return Err(format!("Expected a program file at {name}")),
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {}
+            Err(err) => return Err(err.to_string()),
+        }
+        plan.replace.insert(name.clone(), entry.sha256.clone());
+    }
+
+    let windows_names: BTreeSet<_> = index.files.keys().map(|name| name.to_lowercase()).collect();
+    for (name, old_hash) in &installed.files {
+        if index.files.contains_key(name) {
+            continue;
+        }
+        if windows_names.contains(&name.to_lowercase()) {
+            return Err(format!("Program filename changed case: {name}"));
+        }
+        let path = local_path(target, name)?;
+        match fs::metadata(&path) {
+            Ok(meta) if meta.is_file() && file_hash(&path)? == *old_hash => {
+                plan.remove.push(name.clone())
+            }
+            Ok(_) => {} // A user-modified file is no longer part of the managed installation.
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {}
+            Err(err) => return Err(err.to_string()),
+        }
+    }
+    Ok(plan)
+}
+
+fn groups<'a>(index: &'a Index, plan: &'a Plan) -> Result<Vec<Vec<(&'a str, &'a Entry)>>, String> {
+    let mut files: Vec<_> = plan
+        .replace
+        .keys()
+        .map(|name| (name.as_str(), &index.files[name]))
+        .collect();
+    files.sort_by_key(|(_, entry)| entry.offset);
+    let mut groups: Vec<Vec<_>> = Vec::new();
+    let mut end = 0;
+    for file in files {
+        if file.1.offset < end {
+            return Err("Overlapping ZIP ranges in the update index".into());
+        }
+        if groups.is_empty() || file.1.offset - end > 4096 {
+            groups.push(Vec::new());
+        }
+        end = file.1.offset + file.1.packed;
+        groups.last_mut().unwrap().push(file);
+    }
+    Ok(groups)
+}
+
+fn download_files(
+    client: &Client,
+    url: &str,
+    index: &Index,
+    plan: &Plan,
+    stage: &Path,
+    index_size: u64,
+) -> Result<(), String> {
+    let groups = groups(index, plan)?;
+    let bounds = |group: &[(&str, &Entry)]| {
+        let first = group[0].1;
+        let last = group.last().unwrap().1;
+        (first.offset, last.offset + last.packed)
+    };
+    let download_bytes: u64 = groups
+        .iter()
+        .map(|group| {
+            let (start, end) = bounds(group);
+            end - start
+        })
+        .sum();
+    if groups.len() > 128 || download_bytes + index_size >= index.archive_size {
+        return Err("Downloading the complete ZIP is more efficient".into());
+    }
+    for group in groups {
+        let (start, end) = bounds(&group);
+        let response = client
+            .get(url)
+            .header(header::RANGE, format!("bytes={start}-{}", end - 1))
+            .header(header::ACCEPT_ENCODING, "identity")
+            .send()
+            .map_err(|err| err.without_url().to_string())?;
+        let expected = format!("bytes {start}-{}/{}", end - 1, index.archive_size);
+        if response.status() != StatusCode::PARTIAL_CONTENT
+            || response
+                .headers()
+                .get(header::CONTENT_RANGE)
+                .and_then(|header| header.to_str().ok())
+                != Some(expected.as_str())
+        {
+            return Err("The ZIP server did not return the requested byte range".into());
+        }
+        let mut source = response.take(end - start);
+        let mut offset = start;
+        for (name, entry) in group {
+            let gap = entry.offset - offset;
+            if result(io::copy(&mut (&mut source).take(gap), &mut io::sink()))? != gap {
+                return Err("The ZIP range ended before the requested file".into());
+            }
+            let destination = stage.join(name);
+            result(fs::create_dir_all(
+                destination.parent().ok_or("Missing staging parent")?,
+            ))?;
+            let mut dest = result(File::create(&destination))?;
+            let mut packed = (&mut source).take(entry.packed);
+            let copied = if entry.compression == 8 {
+                result(io::copy(
+                    &mut DeflateDecoder::new(&mut packed).take(entry.size + 1),
+                    &mut dest,
+                ))?
+            } else {
+                result(io::copy(&mut packed, &mut dest))?
+            };
+            let _ = result(io::copy(&mut packed, &mut io::sink()))?;
+            drop(dest);
+            if packed.limit() != 0
+                || copied != entry.size
+                || file_hash(&destination)? != entry.sha256
+            {
+                return Err(format!("Invalid range download: {name}"));
+            }
+            offset = entry.offset + entry.packed;
+        }
+    }
+    Ok(())
+}
+
+fn github_client(proxy_url: Option<String>) -> Result<Client, String> {
+    let mut builder = Client::builder()
+        .user_agent("MAautodori")
+        .connect_timeout(Duration::from_secs(15))
+        .timeout(Duration::from_secs(120))
+        .redirect(redirect::Policy::custom(|attempt| {
+            if attempt.previous().len() >= 5
+                || attempt.url().scheme() != "https"
+                || !matches!(
+                    attempt.url().host_str(),
+                    Some(
+                        "github.com"
+                            | "release-assets.githubusercontent.com"
+                            | "objects.githubusercontent.com"
+                    )
+                )
+            {
+                attempt.error("Unexpected GitHub download redirect")
+            } else {
+                attempt.follow()
+            }
+        }));
+    if let Some(url) = proxy_url.filter(|value| !value.is_empty()) {
+        builder = builder.proxy(reqwest::Proxy::all(url).map_err(|_| "Invalid update proxy")?);
+    }
+    result(builder.build())
+}
+
+#[tauri::command]
+pub async fn maautodori_apply_index(
+    app: tauri::AppHandle,
+    from: String,
+    to: String,
+    index_digest: String,
+    full_digest: String,
+    full_size: u64,
+    proxy_url: Option<String>,
+) -> Result<(), String> {
+    tauri::async_runtime::spawn_blocking(move || {
+        let target = update_target(&from, &to)?;
+        let current = local_path(&target, "interface.json")?;
+        when_idle(&app, &current, &from, || Ok(()))?;
+        let installed = read_manifest(&target, &from)?;
+        let client = github_client(proxy_url)?;
+        let base = format!("{PROJECT}/releases/download/{to}/{PREFIX}{to}");
+        let mut bytes = Vec::new();
+        let response = client
+            .get(format!("{base}.update-index.json.gz"))
+            .header(header::ACCEPT_ENCODING, "identity")
+            .send()
+            .and_then(reqwest::blocking::Response::error_for_status)
+            .map_err(|err| err.without_url().to_string())?;
+        result(response.take(MAX_INDEX + 1).read_to_end(&mut bytes))?;
+        let index = read_index(&bytes, &index_digest, &full_digest, full_size, &to)?;
+        let plan = plan_update(&target, &index, &installed)?;
+        let cache = local_path(&target, "cache")?;
+        result(fs::create_dir_all(&cache))?;
+        let stage = result(tempfile::tempdir_in(&cache))?;
+        download_files(
+            &client,
+            &format!("{base}.zip"),
+            &index,
+            &plan,
+            stage.path(),
+            bytes.len() as u64,
+        )?;
+        check_interface(&stage.path().join("interface.json"), &to)?;
+        let new_manifest = read_manifest(stage.path(), &to)?;
+        if new_manifest.files.iter().ne(index
+            .files
+            .iter()
+            .filter_map(|(name, entry)| (name != MANIFEST).then_some((name, &entry.sha256))))
+        {
+            return Err("The target file inventory does not match the update index".into());
+        }
+        let backups = local_path(&cache, "old")?;
+        when_idle(&app, &current, &from, || {
+            if plan_update(&target, &index, &read_manifest(&target, &from)?)? != plan {
+                return Err("The installed files changed during download".into());
+            }
+            apply_files(&target, stage.path(), &backups, &plan.replace, &plan.remove)
+        })
+    })
+    .await
+    .map_err(|err| err.to_string())?
+}
