diff --git a/src/services/githubPortableUpdate.ts b/src/services/githubPortableUpdate.ts
new file mode 100644
index 0000000..0d1bec4
--- /dev/null
+++ b/src/services/githubPortableUpdate.ts
@@ -0,0 +1,84 @@
+import * as semver from 'semver';
+import { fetch as tauriFetch } from '@tauri-apps/plugin-http';
+
+export const portableProject = 'https://github.com/Evan-Fantasque/MAautodori';
+const releaseApi = 'https://api.github.com/repos/Evan-Fantasque/MAautodori/releases';
+const prefix = 'MAautodori-win-x64-';
+const tagFormat = /^v\d+\.\d+\.\d+(?:-[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)*)?$/;
+
+export interface PortableAsset {
+  name: string;
+  browser_download_url: string;
+  digest: string;
+  size: number;
+  state: string;
+}
+
+export interface PortableRelease {
+  tag_name: string;
+  draft: boolean;
+  prerelease: boolean;
+  body: string | null;
+  assets: PortableAsset[];
+}
+
+export interface PortableUpdate {
+  version: string;
+  notes: string;
+  full: PortableAsset;
+  index?: PortableAsset;
+}
+
+export function selectPortableUpdate(
+  releases: PortableRelease[],
+  from: string,
+  previews: boolean,
+): PortableUpdate | null {
+  if (!tagFormat.test(from) || !semver.valid(from)) return null;
+  const candidates = releases.filter(
+    ({ tag_name, draft, prerelease }) =>
+      !draft &&
+      (previews || !prerelease) &&
+      tagFormat.test(tag_name) &&
+      semver.valid(tag_name) &&
+      semver.gt(tag_name, from),
+  );
+  candidates.sort((a, b) => semver.rcompare(a.tag_name, b.tag_name));
+  for (const release of candidates) {
+    const version = release.tag_name;
+    const findAsset = (name: string) =>
+      release.assets.find(
+        (asset) =>
+          asset.name === name &&
+          asset.state === 'uploaded' &&
+          Number.isSafeInteger(asset.size) &&
+          asset.size > 0 &&
+          /^sha256:[a-f0-9]{64}$/.test(asset.digest) &&
+          asset.browser_download_url === `${portableProject}/releases/download/${version}/${name}`,
+      );
+    const full = findAsset(`${prefix}${version}.zip`);
+    if (!full) continue;
+    const index = findAsset(`${prefix}${version}.update-index.json.gz`);
+    return {
+      version,
+      notes: release.body || '',
+      full,
+      index: index && index.size < full.size ? index : undefined,
+    };
+  }
+  return null;
+}
+
+export async function checkPortableUpdate(from: string, previews: boolean, proxyUrl?: string) {
+  const response = await tauriFetch(
+    previews ? `${releaseApi}?per_page=30` : `${releaseApi}/latest`,
+    {
+      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'MAautodori' },
+      signal: AbortSignal.timeout(15000),
+      proxy: proxyUrl ? { all: proxyUrl } : undefined,
+    },
+  );
+  if (!response.ok) throw new Error(`GitHub HTTP ${response.status}`);
+  const data = await response.json();
+  return selectPortableUpdate(Array.isArray(data) ? data : [data], from, previews);
+}
