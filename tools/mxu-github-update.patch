index 0000000..9e46bd9
--- /dev/null
+++ b/src-tauri/src/commands/portable_update.rs
@@ -0,0 +1,341 @@
+//! GitHub portable updates for the MAautodori Windows distribution.
+
+use super::{
+    apply_full_update, is_interface_file, move_to_old_folder_in_dir, retry_file_op,
+    FullUpdateJournal, OLD_DIR_LOCK,
+};
+use crate::commands::{types::MaaState, utils::get_exe_directory};
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::{self, File},
+    io,
+    path::{Path, PathBuf},
+};
+use tauri::Manager;
+
+const PREFIX: &str = "MAautodori-win-x64-";
+const PROJECT: &str = "https://github.com/Evan-Fantasque/MAautodori";
+const ROOT_FILES: &[&str] = &[
+    "interface.json",
+    "mxu.exe",
+    "LICENSE",
+    "README.md",
+    "requirements.txt",
+];
+const ROOT_DIRS: &[&str] = &["agent", "licenses", "maafw", "python", "resource", "share"];
+
+#[derive(Deserialize)]
+struct Interface {
+    version: String,
+    github: String,
+}
+
+#[derive(Deserialize)]
+struct Changes {
+    base_version: String,
+    target_version: String,
+    deleted: Vec<String>,
+    base: BTreeMap<String, String>,
+    files: BTreeMap<String, String>,
+}
+
+fn result<T>(value: Result<T, impl std::fmt::Display>) -> Result<T, String> {
+    value.map_err(|err| err.to_string())
+}
+
+fn managed(name: &str) -> bool {
+    if name.contains(['\\', ':', '\0'])
+        || name.split('/').any(|part| {
+            part.is_empty()
+                || part.ends_with(['.', ' '])
+                || matches!(
+                    part.split('.')
+                        .next()
+                        .unwrap_or_default()
+                        .to_ascii_uppercase()
+                        .as_str(),
+                    "CON"
+                        | "PRN"
+                        | "AUX"
+                        | "NUL"
+                        | "CONIN$"
+                        | "CONOUT$"
+                        | "COM1"
+                        | "COM2"
+                        | "COM3"
+                        | "COM4"
+                        | "COM5"
+                        | "COM6"
+                        | "COM7"
+                        | "COM8"
+                        | "COM9"
+                        | "LPT1"
+                        | "LPT2"
+                        | "LPT3"
+                        | "LPT4"
+                        | "LPT5"
+                        | "LPT6"
+                        | "LPT7"
+                        | "LPT8"
+                        | "LPT9"
+                )
+        })
+    {
+        return false;
+    }
+    name.split_once('/').map_or_else(
+        || ROOT_FILES.contains(&name),
+        |(root, _)| ROOT_DIRS.contains(&root),
+    )
+}
+
+fn local_path(root: &Path, name: &str) -> Result<PathBuf, String> {
+    let mut path = root.to_owned();
+    for part in name.split('/') {
+        path.push(part);
+        match fs::symlink_metadata(&path) {
+            Ok(meta) => {
+                #[cfg(windows)]
+                {
+                    use std::os::windows::fs::MetadataExt;
+                    if meta.file_attributes() & 0x400 != 0 {
+                        return Err(format!("Update path is a reparse point: {name}"));
+                    }
+                }
+                if meta.file_type().is_symlink() {
+                    return Err(format!("Update path is a symbolic link: {name}"));
+                }
+            }
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {}
+            Err(err) => return Err(err.to_string()),
+        }
+    }
+    Ok(path)
+}
+
+fn file_hash(path: &Path) -> Result<String, String> {
+    let mut reader = result(File::open(path))?;
+    let mut hash = Sha256::new();
+    result(io::copy(&mut reader, &mut hash))?;
+    Ok(format!("{:x}", hash.finalize()))
+}
+
+fn check_interface(path: &Path, version: &str) -> Result<(), String> {
+    let file = result(File::open(path))?;
+    let interface: Interface = result(serde_json::from_reader(file))?;
+    if interface.version != version || interface.github != PROJECT {
+        return Err("The installed or target version does not match the update".into());
+    }
+    Ok(())
+}
+
+fn extract(
+    zip_file: &Path,
+    stage: &Path,
+    full_prefix: Option<&str>,
+) -> Result<BTreeSet<String>, String> {
+    let mut archive = result(zip::ZipArchive::new(result(File::open(zip_file))?))?;
+    let mut names = BTreeSet::new();
+    let mut windows_names = BTreeSet::new();
+    for index in 0..archive.len() {
+        let mut member = result(archive.by_index(index))?;
+        let name = match full_prefix {
+            Some(prefix) => member
+                .name()
+                .strip_prefix(prefix)
+                .ok_or("Wrong portable archive root")?,
+            None => member.name(),
+        };
+        if member.is_dir() {
+            continue;
+        }
+        if !(managed(name) || (full_prefix.is_none() && name == "changes.json"))
+            || !windows_names.insert(name.to_lowercase())
+            || member
+                .unix_mode()
+                .is_some_and(|mode| mode & 0o170000 == 0o120000)
+        {
+            return Err(format!("Invalid update archive member: {name}"));
+        }
+        let path = stage.join(name);
+        result(fs::create_dir_all(
+            path.parent().ok_or("Missing archive parent")?,
+        ))?;
+        let mut dest = result(File::create(path))?;
+        names.insert(name.to_owned());
+        result(io::copy(&mut member, &mut dest))?;
+    }
+    Ok(names)
+}
+
+fn apply_delta(
+    target: &Path,
+    stage: &Path,
+    backups: &Path,
+    names: BTreeSet<String>,
+    from: &str,
+    to: &str,
+) -> Result<(), String> {
+    let manifest: Changes = result(serde_json::from_reader(result(File::open(
+        stage.join("changes.json"),
+    ))?))?;
+    let deleted: BTreeSet<_> = manifest.deleted.iter().collect();
+    if manifest.base_version != from
+        || manifest.target_version != to
+        || !manifest.files.contains_key("interface.json")
+        || names
+            .iter()
+            .filter(|name| name.as_str() != "changes.json")
+            .ne(manifest.files.keys())
+        || deleted.len() != manifest.deleted.len()
+        || deleted
+            .iter()
+            .any(|name| !manifest.base.contains_key(*name) || manifest.files.contains_key(*name))
+        || manifest
+            .base
+            .keys()
+            .chain(manifest.files.keys())
+            .any(|name| !managed(name))
+    {
+        return Err("The incremental manifest does not match this update".into());
+    }
+
+    for (name, expected) in &manifest.base {
+        if file_hash(&local_path(target, name)?)? != *expected {
+            return Err(format!(
+                "Installed file differs from the incremental base: {name}"
+            ));
+        }
+    }
+    for (name, expected) in &manifest.files {
+        if file_hash(&stage.join(name))? != *expected {
+            return Err(format!("Invalid incremental file hash: {name}"));
+        }
+        if !manifest.base.contains_key(name) && local_path(target, name)?.exists() {
+            return Err(format!(
+                "A new program file would replace a local file: {name}"
+            ));
+        }
+    }
+
+    let mut touched: Vec<_> = manifest
+        .deleted
+        .iter()
+        .chain(manifest.files.keys())
+        .collect();
+    touched.sort_by_key(|name| is_interface_file(std::ffi::OsStr::new(name.as_str())));
+    let _guard = OLD_DIR_LOCK.lock().unwrap_or_else(|err| err.into_inner());
+    let mut journal = FullUpdateJournal::default();
+    let apply = (|| -> Result<(), String> {
+        for name in touched {
+            let dest = local_path(target, name)?;
+            if let Some(backup) = retry_file_op(name, || move_to_old_folder_in_dir(&dest, backups))?
+            {
+                journal.moved.push((dest.clone(), backup));
+            }
+            if let Some(expected) = manifest.files.get(name) {
+                result(fs::create_dir_all(
+                    dest.parent().ok_or("Missing destination parent")?,
+                ))?;
+                journal.copied.push(dest.clone());
+                result(fs::copy(stage.join(name), &dest))?;
+                if file_hash(&dest)? != *expected {
+                    return Err(format!("File changed while installing: {name}"));
+                }
+            }
+        }
+        Ok(())
+    })();
+    if let Err(err) = apply {
+        if !journal.rollback() {
+            return Err(format!("ROLLBACK_FAILED: {err}"));
+        }
+        return Err(err);
+    }
+    Ok(())
+}
+
+#[tauri::command]
+pub async fn maautodori_apply_update(
+    app: tauri::AppHandle,
+    zip_path: String,
+    digest: String,
+    from: String,
+    to: String,
+    incremental: bool,
+) -> Result<(), String> {
+    tauri::async_runtime::spawn_blocking(move || {
+        if !cfg!(target_os = "windows") {
+            return Err("This portable update requires Windows".into());
+        }
+        let parse = |value: &str| semver::Version::parse(value.trim_start_matches('v'));
+        if result(parse(&to))? <= result(parse(&from))? {
+            return Err("Update target must be newer than the installed version".into());
+        }
+        let target = get_exe_directory()?;
+        let current = local_path(&target, "interface.json")?;
+        check_interface(&current, &from)?;
+        let cache = local_path(&target, "cache")?;
+        let backups = local_path(&cache, "old")?;
+        let zip_path = PathBuf::from(zip_path);
+        let filename = if incremental {
+            format!("{PREFIX}{from}-to-{to}.delta.zip")
+        } else {
+            format!("{PREFIX}{to}.zip")
+        };
+        let local_zip = local_path(&cache, &filename)?;
+        if result(zip_path.canonicalize())? != result(local_zip.canonicalize())?
+            || digest.strip_prefix("sha256:") != Some(file_hash(&local_zip)?.as_str())
+        {
+            return Err("The downloaded update failed SHA-256 verification".into());
+        }
+        let temp = result(tempfile::tempdir_in(&cache))?;
+        let prefix = format!("{PREFIX}{to}/");
+        let stage = temp.path();
+        let names = extract(&local_zip, stage, (!incremental).then_some(prefix.as_str()))?;
+        check_interface(&stage.join("interface.json"), &to)?;
+        let state = app.state::<std::sync::Arc<MaaState>>();
+        let instances = state
+            .instances
+            .lock()
+            .unwrap_or_else(|err| err.into_inner());
+        if instances.values().any(|value| value.is_running()) {
+            return Err("UPDATE_BUSY".into());
+        }
+        check_interface(&current, &from)?;
+        if incremental {
+            apply_delta(&target, stage, &backups, names, &from, &to)?;
+        } else {
+            if !ROOT_FILES.iter().all(|name| names.contains(*name))
+                || ![
+                    "agent/main.py",
+                    "python/python.exe",
+                    "maafw/MaaFramework.dll",
+                ]
+                .iter()
+                .all(|name| names.contains(*name))
+            {
+                return Err("The complete portable archive is missing runtime files".into());
+            }
+            apply_full_update(
+                stage.to_string_lossy().into_owned(),
+                target.to_string_lossy().into_owned(),
+            )
+            .map_err(|err| {
+                if err.rolled_back {
+                    err.message
+                } else {
+                    format!("ROLLBACK_FAILED: {}", err.message)
+                }
+            })?;
+        }
+        drop(instances);
+        // Installation has already committed. Failure to clean a cached ZIP does not undo it.
+        let _ = fs::remove_file(local_zip);
+        Ok(())
+    })
+    .await
+    .map_err(|err| err.to_string())?
+}
